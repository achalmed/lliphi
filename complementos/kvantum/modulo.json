{
  "nombre": "Kvantum",
  "resumen": "Estilo de las aplicaciones Qt derivado del Kvantum de WhiteSur (menús y tooltips translúcidos, controles redondeados) en los colores de cada variante.",
  "clase": "paquete",
  "orden": 2,
  "formato": "Kvantum",
  "tecnologia": "tema de Kvantum (`.kvconfig` + `.svg`) en `~/.config/Kvantum/`; derivado de WhiteSur-kde, GPL-3.0-or-later",
  "estado": "probado",
  "desde": "0.2.0",
  "licencia": "GPL-3.0-or-later",
  "archivos": [
    "LliphiClaro/",
    "LliphiOscuro/"
  ],
  "capturas": [],
  "dependencias": {
    "bases": [
      "fuentes/base/WhiteSur-kde"
    ],
    "herramientas_opcionales": [
      "kwriteconfig6"
    ],
    "terceros": [
      "Kvantum (qt6-style-kvantum de la distribución)"
    ]
  },
  "instalacion": [
    {
      "origen": "{id_esquema[claro]}",
      "destino": "Kvantum/{id_esquema[claro]}",
      "base": "config"
    },
    {
      "origen": "{id_esquema[oscuro]}",
      "destino": "Kvantum/{id_esquema[oscuro]}",
      "base": "config"
    }
  ]
}
