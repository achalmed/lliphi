  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#97989c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palabras clave y almacenamiento",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#f28881"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#bcbec1"
      }
    },
    {
      "name": "Puntuación",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#bcbec1"
      }
    },
    {
      "name": "Cadenas",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#69c27e"
      }
    },
    {
      "name": "Escapes y expresiones regulares",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#00c2ca"
      }
    },
    {
      "name": "Números y constantes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d0a43a"
      }
    },
    {
      "name": "Funciones y métodos",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.function.member",
        "variable.function",
        "meta.require",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#7daafd"
      }
    },
    {
      "name": "Tipos, clases e interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#00c2ca"
      }
    },
    {
      "name": "Variables y propiedades",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "variable.other.object",
        "meta.object-literal.key",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "foreground": "#eaebed"
      }
    },
    {
      "name": "Parámetros",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#eaebed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Etiquetas (HTML, XML, JSX)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag.sgml",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#f28881"
      }
    },
    {
      "name": "Atributos, decoradores y símbolos",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "entity.name.function.decorator",
        "constant.other.symbol",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#d98cd2"
      }
    },
    {
      "name": "Propiedades CSS y claves",
      "scope": [
        "support.type.property-name",
        "meta.property-name",
        "support.type.property-name.json",
        "string.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#eaebed"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#f28881",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrita",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#eaebed",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: cursiva",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#eaebed",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#69c27e"
      }
    },
    {
      "name": "Markdown: listas y citas",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "markup.quote",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#bcbec1"
      }
    },
    {
      "name": "Enlaces",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#ff958d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diferencias: insertado",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#6fc884"
      }
    },
    {
      "name": "Diferencias: borrado",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#fb817a"
      }
    },
    {
